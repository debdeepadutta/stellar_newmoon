pragma language_version >= 0.23;

import CompactStandardLibrary;

// The public ledger state
export ledger secretHash: Bytes<32>;
export ledger isUnlocked: Boolean;

// The deploy circuit runs once upon deployment.
// It takes a private 32-byte secret, hashes it locally, and stores the hash publicly.
// This proves the deployer knows the secret without revealing it on-chain.
export circuit deploy(secret: Bytes<32>): [] {
    secretHash = sha2_256(secret);
    isUnlocked = false;
}

// The unlock circuit takes a private 32-byte attempt.
// It hashes the attempt locally and compares it to the public hash.
// If it matches, it updates the public state to true.
// The attempt is never revealed to the network!
export circuit unlock(secretAttempt: Bytes<32>): [] {
    assert sha2_256(secretAttempt) == secretHash "Incorrect secret!";
    isUnlocked = true;
}
