pragma language_version >= 0.23;

export ledger minimumAge: Uint<32>;
export ledger lastVerificationSuccess: Boolean;

constructor(threshold: Uint<32>) {
    minimumAge = disclose(threshold);
    lastVerificationSuccess = false;
}

export circuit verify(myAge: Uint<32>): [] {
    assert(myAge >= minimumAge, "You do not meet the minimum age requirement!");
    lastVerificationSuccess = true;
}
